# Production domain, only once approved. Enables canonical URLs, sitemap and indexing (with SIDEKICK_INDEXABLE).
# SIDEKICK_SITE_URL=https://example.com
# Set to "true" only for the approved public launch build. Anything else emits noindex + Disallow.
# SIDEKICK_INDEXABLE=false
# Beta form destination: your Google Apps Script web-app URL (ends in /exec). See
# integrations/google-sheets/SETUP.md. Overrides BETA_FORM_ENDPOINT in src/config/site.ts. Empty = no form.
# PUBLIC_BETA_FORM_ENDPOINT=https://script.google.com/macros/s/…/exec
# Support address, once approved by the publisher. Empty = not shown.
# PUBLIC_SUPPORT_EMAIL=

---
import PrimaryButton from './PrimaryButton.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';
const endpoint = site.betaFormEndpoint;
const destination = site.betaFormDestination;
const playTesting = site.androidBetaDistribution === 'google-play-testing';
---
{!endpoint && (
<div class="beta-closed" data-beta-closed>
  <div class="beta-form__notice" role="note">
    <Icon name="circle-alert" size={20} />
    <div>
      <p><strong>Requests aren’t open on this page yet.</strong></p>
      <p>Where beta requests should go hasn’t been connected, so there’s no form here and nothing is collected. If someone running the beta pointed you here, reply to them directly.</p>
    </div>
  </div>
  <p class="beta-closed__lead">When requests open, the form will ask for:</p>
  <ol class="beta-closed__list">
    <li><span>Your name</span><span class="muted">so we know who we’re inviting</span></li>
    <li><span>Your Google account email</span><span class="muted">{playTesting ? 'to add you as a tester on Google Play' : 'to send the invitation'}</span></li>
    <li><span>Your Mac type</span><span class="muted">Apple silicon, Intel, or not sure</span></li>
    <li><span>Your Android phone model and version</span><span class="muted">so testing covers more makers</span></li>
    <li><span>Your country, and what you’d most like Sidekick to do</span><span class="muted">both optional</span></li>
  </ol>
  <p class="field__hint">No phone number, no address, no account.</p>
</div>
)}
{endpoint && destination && (
<form
  class="beta-form"
  method="post"
  action={endpoint}
  accept-charset="UTF-8"
  novalidate
  data-beta-form
  data-endpoint={endpoint}
  aria-describedby="beta-form-status-note"
>
  <p class="beta-form__dest" id="beta-form-status-note">
    Your answers are saved to {destination} and used only to run the beta.{' '}
    <a class="text-link" href="/privacy#beta-form">How it’s handled</a>
  </p>

  <fieldset>
    <legend class="visually-hidden">Beta access request</legend>

    <div class="field">
      <label for="bf-name">Your name</label>
      <input id="bf-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="bf-name-err" />
      <p class="field__err" id="bf-name-err" hidden></p>
    </div>

    <div class="field">
      <label for="bf-email">Google account email</label>
      <input id="bf-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" aria-describedby="bf-email-hint bf-email-err" />
      <p class="field__hint" id="bf-email-hint">
        {playTesting
          ? 'The account signed in to the Play Store on your Android phone — Gmail or Google Workspace. Google Play only lets that account install the test version.'
          : 'We’ll send the invitation here.'}
      </p>
      <p class="field__err" id="bf-email-err" hidden></p>
    </div>

    <fieldset class="field field--group" aria-describedby="bf-mac-err">
      <legend>Your Mac</legend>
      <div class="choices">
        <label class="choice"><input type="radio" name="mac" value="apple-silicon" required /><span>Apple silicon</span></label>
        <label class="choice"><input type="radio" name="mac" value="intel" /><span>Intel</span></label>
        <label class="choice"><input type="radio" name="mac" value="not-sure" /><span>Not sure</span></label>
      </div>
      <p class="field__hint">Apple menu → About This Mac shows “Chip: Apple M…” for Apple silicon.</p>
      <p class="field__err" id="bf-mac-err" hidden></p>
    </fieldset>

    <div class="field-row">
      <div class="field">
        <label for="bf-phone">Android phone model</label>
        <input id="bf-phone" name="phone_model" type="text" required maxlength="120" autocomplete="off" placeholder="e.g. Galaxy S24, Pixel 8" aria-describedby="bf-phone-hint bf-phone-err" />
        <p class="field__hint" id="bf-phone-hint">Settings → About phone.</p>
        <p class="field__err" id="bf-phone-err" hidden></p>
      </div>
      <div class="field">
        <label for="bf-android">Android version</label>
        <select id="bf-android" name="android_version" required aria-describedby="bf-android-hint bf-android-err">
          <option value="">Choose…</option>
          {['16', '15', '14', '13', '12', '11', '10'].map((v) => <option value={v}>Android {v}</option>)}
          <option value="not-sure">Not sure</option>
        </select>
        <p class="field__hint" id="bf-android-hint">Sidekick needs Android 10 or later.</p>
        <p class="field__err" id="bf-android-err" hidden></p>
      </div>
    </div>

    <div class="field">
      <label for="bf-country">Country <span class="field__opt">Optional</span></label>
      <input id="bf-country" name="country" type="text" autocomplete="country-name" maxlength="60" aria-describedby="bf-country-hint" />
      <p class="field__hint" id="bf-country-hint">{playTesting ? 'Google Play tests are available country by country.' : 'Helps us plan where testers are.'}</p>
    </div>

    <div class="field">
      <label for="bf-wish">What would you most like Sidekick to do? <span class="field__opt">Optional</span></label>
      <textarea id="bf-wish" name="wish" rows="3" maxlength="1000"></textarea>
    </div>

    <div class="field">
      <label class="consent" for="bf-consent">
        <input id="bf-consent" name="consent" type="checkbox" value="yes" required aria-describedby="bf-consent-err" />
        <span>
          Save these details in {destination} and use them to contact me about the beta{playTesting ? ' and to add my email to the Google Play test' : ''}.
          I can ask to be removed at any time. <a class="text-link" href="/privacy#beta-form">Privacy</a>
        </span>
      </label>
      <p class="field__err" id="bf-consent-err" hidden></p>
    </div>

    <div class="field field--hp" aria-hidden="true">
      <label for="bf-website">Leave this empty</label>
      <input id="bf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="beta-form__actions">
      <PrimaryButton type="submit" size="lg" icon="arrow-right" data-submit>
        Request beta access
      </PrimaryButton>
      <p class="field__hint">Nothing is shared with anyone else{playTesting ? ', except your email with Google Play if you’re selected' : ''}.</p>
    </div>
  </fieldset>

  <div class="beta-form__result" role="status" aria-live="polite" data-result hidden></div>
</form>
)}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-beta-form]');
  const endpoint = form?.dataset.endpoint;
  if (form && endpoint) {
    const result = form.querySelector<HTMLElement>('[data-result]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const $ = <T extends HTMLElement>(sel: string) => form.querySelector<T>(sel)!;
    const setErr = (id: string, msg: string | null, input?: HTMLElement | null) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.hidden = !msg;
      el.textContent = msg ?? '';
      input?.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };
    const validate = () => {
      const errors: HTMLElement[] = [];
      const check = (id: string, input: HTMLElement, msg: string | null) => {
        setErr(id, msg, input);
        if (msg) errors.push(input);
      };
      const name = $<HTMLInputElement>('#bf-name');
      check('bf-name-err', name, name.value.trim() ? null : 'Enter your name.');
      const email = $<HTMLInputElement>('#bf-email');
      check(
        'bf-email-err',
        email,
        !email.value.trim()
          ? 'Enter your Google account email.'
          : email.validity.typeMismatch
            ? 'That email address doesn’t look complete — check for a missing @ or domain.'
            : null,
      );
      const mac = form.querySelector<HTMLInputElement>('input[name="mac"]:checked');
      setErr('bf-mac-err', mac ? null : 'Choose your Mac type, or “Not sure”.');
      if (!mac) errors.push($('input[name="mac"]'));
      const phone = $<HTMLInputElement>('#bf-phone');
      check('bf-phone-err', phone, phone.value.trim() ? null : 'Enter your phone’s model — it helps us cover different Android makers.');
      const android = $<HTMLSelectElement>('#bf-android');
      check('bf-android-err', android, android.value ? null : 'Choose your Android version, or “Not sure”.');
      const consent = $<HTMLInputElement>('#bf-consent');
      check('bf-consent-err', consent, consent.checked ? null : 'Tick the box so we can store your request.');
      return errors;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errors = validate();
      if (errors.length) {
        errors[0].focus();
        return;
      }
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      result.hidden = false;
      result.className = 'beta-form__result';
      result.textContent = 'Sending…';
      try {
        // URL-encoded body and no custom headers: a "simple" cross-origin request, which a Google
        // Apps Script web app accepts without a CORS preflight.
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        body.set('_js', '1');
        const res = await fetch(endpoint, { method: 'POST', body });
        // Saved only if the receiver says so: Apps Script answers HTTP 200 even when it fails.
        const reply = res.ok ? await res.json().catch(() => null) : null;
        if (!reply || reply.ok !== true) throw new Error(reply?.error ?? String(res.status));
        result.classList.add('is-ok');
        result.textContent = 'Request received. If there’s a place in the beta, you’ll get an email with what to do next.';
        form.querySelector('fieldset')!.disabled = true;
      } catch (err) {
        result.classList.add('is-error');
        result.textContent =
          err instanceof Error && err.message === 'invalid'
            ? 'Some answers weren’t accepted, and nothing was saved. Check each field and try again.'
            : 'Your request didn’t go through, and nothing was saved. Check your connection and try again.';
        submit.disabled = false;
      } finally {
        submit.removeAttribute('aria-busy');
      }
    });
  }
</script>

<style>
  .beta-form {
    display: grid;
    gap: var(--s-6);
  }
  .beta-form fieldset {
    border: 0;
    padding: 0;
    min-width: 0;
    display: grid;
    gap: var(--s-6);
  }
  .beta-form fieldset[disabled] {
    opacity: 0.7;
  }
  .beta-form__notice {
    display: flex;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-md);
    border: 1px solid rgb(255 181 71 / 0.35);
    background: var(--warning-tint);
    font-size: var(--fs-sm);
  }
  .beta-form__notice :global(svg) {
    color: var(--warning);
    flex: none;
    margin-top: 0.1em;
  }
  .beta-form__notice strong {
    color: var(--text);
  }
  .beta-form__notice p + p {
    margin-top: var(--s-1);
  }
  .beta-closed {
    display: grid;
    gap: var(--s-5);
  }
  .beta-closed__lead {
    font-size: var(--fs-sm);
    color: var(--text);
  }
  .beta-closed__list {
    list-style: none;
    padding: 0;
    counter-reset: q;
    border-top: 1px solid var(--line);
  }
  .beta-closed__list li {
    counter-increment: q;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0 var(--s-2);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--text);
  }
  .beta-closed__list li::before {
    content: counter(q, decimal-leading-zero);
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    padding-top: 0.2em;
  }
  .beta-closed__list .muted {
    font-size: var(--fs-xs);
  }
  .beta-form__dest {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .field {
    display: grid;
    gap: var(--s-2);
    min-width: 0;
  }
  .field > label,
  .field--group > legend {
    color: var(--text);
    font-weight: 550;
    font-size: var(--fs-sm);
    padding: 0;
  }
  .field--group {
    gap: var(--s-2) !important;
  }
  .field__opt {
    color: var(--text-muted);
    font-weight: 400;
    margin-left: var(--s-2);
  }
  .field input[type='email'],
  .field input[type='text'],
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-sm);
    border: 1px solid var(--line-control);
    background: var(--surface-well);
    color: var(--text);
    transition: border-color var(--dur-fast);
  }
  .field textarea {
    resize: vertical;
  }
  .field input[type='email'],
  .field input[type='text'],
  .field select {
    height: 52px;
  }
  .field select {
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-sm);
    border: 1px solid var(--line-control);
    background: var(--surface-well);
    color: var(--text);
  }
  .field select:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }
  .field-row {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 560px) {
    .field-row {
      grid-template-columns: 3fr 2fr;
      gap: var(--s-4);
    }
  }
  .field > .consent {
    font-weight: 400;
    color: var(--text-body);
  }
  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    align-items: start;
    font-size: var(--fs-sm);
    color: var(--text-body);
    cursor: pointer;
  }
  .consent input {
    width: 20px;
    height: 20px;
    margin: 0.1em 0 0;
    accent-color: var(--accent);
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #8a8c98;
  }
  .field input:hover,
  .field textarea:hover {
    border-color: rgb(255 255 255 / 0.32);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
    border-color: transparent;
  }
  .field [aria-invalid='true'] {
    border-color: var(--danger);
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .choice {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-4) 0 var(--s-3);
    border-radius: var(--r-sm);
    border: 1px solid var(--line-control);
    cursor: pointer;
    color: var(--text);
    font-size: var(--fs-sm);
  }
  .choice input {
    accent-color: var(--accent);
    width: 18px;
    height: 18px;
    margin: 0;
  }
  .choice:has(input:checked) {
    border-color: var(--accent-line);
    background: var(--accent-tint);
  }
  .choice:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .field__hint {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .field__err {
    font-size: var(--fs-sm);
    color: #ff9a9a;
    display: flex;
    gap: var(--s-2);
  }
  .field__err::before {
    content: '!';
    font-weight: 700;
    width: 1.2em;
    height: 1.2em;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--danger-tint);
    font-size: 0.85em;
    margin-top: 0.15em;
  }
  .field--hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .beta-form__actions {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }
  .beta-form__result {
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-md);
    border: 1px solid var(--line-strong);
    font-size: var(--fs-sm);
    color: var(--text);
  }
  .beta-form__result.is-ok {
    border-color: var(--accent-line);
  }
  .beta-form__result.is-error {
    border-color: rgb(255 92 92 / 0.5);
    background: var(--danger-tint);
  }
</style>

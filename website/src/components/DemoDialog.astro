---
/*
 * Rendered only when site.demoVideo is configured with an approved, sanitized recording.
 * Native <dialog>: Escape closes, focus is trapped by the browser's modal handling, and focus
 * returns to the trigger. The video is paused and rewound on close and never autoplays with sound.
 */
import Icon from './Icon.astro';
interface Props {
  video: { src: string; poster: string; captions: string; title: string };
}
const { video } = Astro.props;
---
<div id="demo" class="demo-fallback">
  <!-- Without JS, the trigger's #demo anchor lands here and the video is playable inline. -->
  <noscript>
    <video controls preload="none" poster={video.poster} width="1280" height="800">
      <source src={video.src} type="video/mp4" />
      <track kind="captions" src={video.captions} srclang="en" label="English" default />
    </video>
  </noscript>
</div>
<dialog class="demo" aria-labelledby="demo-title" data-demo>
  <div class="demo__bar">
    <h2 id="demo-title">{video.title}</h2>
    <button type="button" class="demo__close" data-demo-close>
      <Icon name="x" size={20} /><span class="visually-hidden">Close video</span>
    </button>
  </div>
  <video controls preload="none" playsinline poster={video.poster} width="1280" height="800" data-demo-video>
    <source src={video.src} type="video/mp4" />
    <track kind="captions" src={video.captions} srclang="en" label="English" default />
  </video>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-demo]');
  const videoEl = dialog?.querySelector<HTMLVideoElement>('[data-demo-video]');
  let trigger: HTMLElement | null = null;
  if (dialog && videoEl) {
    document.querySelectorAll<HTMLElement>('[data-demo-trigger]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        trigger = el;
        dialog.showModal();
        dialog.querySelector<HTMLElement>('[data-demo-close]')?.focus();
      }),
    );
    dialog.querySelector('[data-demo-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      videoEl.pause();
      videoEl.currentTime = 0;
      trigger?.focus();
    });
  }
</script>

<style>
  .demo {
    width: min(1100px, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--bg-chrome);
    color: var(--text);
  }
  .demo::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  .demo__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-5);
  }
  .demo__bar h2 {
    font-size: 1rem;
  }
  .demo__close {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--r-sm);
    border: 1px solid var(--line-strong);
    background: transparent;
  }
  .demo video {
    width: 100%;
    background: #000;
  }
</style>

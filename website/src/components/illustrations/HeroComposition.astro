---
import Icon from '../Icon.astro';
import NotificationsPane from './NotificationsPane.astro';
import PhoneFrame from './PhoneFrame.astro';
---
<figure class="hero-comp" aria-labelledby="hero-comp-cap">
  <div class="hero-comp__stage" role="img" aria-label="Illustration: the Sidekick Mac app's Notifications screen shows a message from a fictional contact, Maya Chen, with a reply being typed. Beside the Mac window, an Android phone shows the same notification. A thin line links the two devices.">
    <NotificationsPane class="hero-comp__mac" />
    <div class="hero-comp__link" aria-hidden="true">
      <svg viewBox="0 0 120 60" preserveAspectRatio="none"><path d="M2 2 C 50 2, 70 58, 118 58" /></svg>
      <span class="hero-comp__pulse"></span>
    </div>
    <PhoneFrame class="hero-comp__phone" wallpaper>
      <div class="phone__clock"><b>2:47</b><span>Tuesday</span></div>
      <div class="hero-comp__spacer"></div>
      <div class="phone__notif">
        <div class="ui-row"><Icon name="message-square" size={12} /><span class="phone__notif-app">Chat app · now</span></div>
        <div class="phone__notif-title">Maya Chen</div>
        <div class="phone__notif-text">Are we still on for 3? I can bring the slides.</div>
      </div>
      <div class="phone__notif hero-comp__sk">
        <div class="ui-row"><img src="/mark-56.png" alt="" width="20" height="10" /><span class="phone__notif-app">Sidekick · connected to Studio Mac</span></div>
      </div>
    </PhoneFrame>
  </div>
  <figcaption id="hero-comp-cap" class="illus-label">Illustration · fictional data, not a screenshot</figcaption>
</figure>

<style>
  .hero-comp {
    position: relative;
    display: grid;
    gap: var(--s-4);
  }
  .hero-comp__stage {
    position: relative;
    padding-right: 20%;
    padding-bottom: 12%;
  }
  .hero-comp__stage :global(.hero-comp__phone) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 24%;
    min-width: 0;
  }
  .hero-comp__spacer {
    flex: 1;
  }
  .hero-comp__stage :global(.hero-comp__sk img) {
    width: 1.6em;
    height: auto;
  }
  .hero-comp__link {
    position: absolute;
    left: 58%;
    top: 81.5%;
    width: 18%;
    height: 9%;
    pointer-events: none;
  }
  .hero-comp__link svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero-comp__link path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 3 4;
    opacity: 0.8;
  }
  .hero-comp__pulse {
    position: absolute;
    left: -3px;
    top: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-comp__link path {
      animation: dash 1.6s linear 6;
    }
    .hero-comp__stage :global(.hero-comp__phone) {
      animation: reveal var(--dur-slow) var(--ease-out) 160ms both;
    }
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -14;
    }
  }
  /* Phones: a deliberate crop instead of a shrunken window. The Mac window renders wider than the
     screen and is cut at the viewport's left edge, keeping the notification detail and reply legible. */
  @media (max-width: 639.98px) {
    .hero-comp__stage {
      margin-left: calc(var(--gutter) * -1);
      padding-right: 0;
      padding-bottom: 34%;
      overflow: hidden;
    }
    .hero-comp__stage :global(.hero-comp__mac) {
      width: 165%;
      margin-left: -65%;
    }
    .hero-comp__stage :global(.hero-comp__mac .mac__window) {
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }
    .hero-comp__stage :global(.hero-comp__phone) {
      width: 36%;
      right: 2px;
    }
    .hero-comp__link {
      display: none;
    }
  }
  .hero-comp figcaption,
  .hero-comp .illus-label {
    justify-self: start;
  }
</style>
